    <a href='/#blog'>
      <svg fill='none' height='19' stroke='currentColor' stroke-width='2.3' viewBox='0 0 24 24' width='19'><path d='M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Z'/><path d='M10 6h8v4h-8V6Z'/></svg>
      Blog
    </a>
    <a href='https://www.palmaestro.xyz/p/la-ferre-de-julio.html'>
      <svg fill='none' height='19' stroke='currentColor' stroke-width='2.3' viewBox='0 0 24 24' width='19'><path d='M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z'/></svg>
